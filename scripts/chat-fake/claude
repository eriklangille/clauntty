#!/bin/bash
# A stand-in for `claude -p --input-format stream-json --output-format stream-json ...` on
# the test container: it replays a recorded session (recording.tsv beside it, made by
# make-fixture.py) with its timing, one recorded turn per prompt, round and round. It waits
# at each approval or question for the app's control_response, stops a turn on an
# interrupt, and answers a denial with a short reply. Everything else is ignored, so the
# chat view can be built without a Claude login or usage.
here=$(dirname "$(readlink -f "$0")")
rec="$here/recording.tsv"
sid="" replay="" headless=""
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id|--resume) sid=$2; shift ;;
    --replay-user-messages) replay=1 ;;
    -p|--print) headless=1 ;;
  esac
  shift
done
[ -n "$sid" ] || sid=$(cat /proc/sys/kernel/random/uuid)

# Without -p it's Claude's own interface, in the terminal: a stand-in that tells rtach what
# Claude's hooks would (the conversation's id, idle, working, done, the end) and leaves on
# /exit, for trying the switch between the terminal and the chat view
if [ -z "$headless" ]; then
  hook() { printf '{"session_id":"%s"}' "$sid" | ~/.clauntty/bin/clauntty agent-state "$1" 2>/dev/null; }
  printf '\033]0;\342\234\263 Claude Code\007'
  printf 'Claude Code (stand-in) \302\267 conversation %s\nType /exit to leave.\n\n> ' "$sid"
  hook idle
  while IFS= read -r line; do
    case "$line" in
      /exit) break ;;
      *) hook working; sleep 1; printf 'You said: %s\n\n' "$line"; hook done ;;
    esac
    printf '> '
  done
  hook end
  exit 0
fi
turns=$(( $(cut -f1 "$rec" | sort -n | tail -n 1) + 1 ))
played=${CHAT_FAKE_TURN:-0}  # the turn to start at, for trying one

emit() { printf '%s\n' "${1//__SID__/$sid}"; }

# Claude's echo of a message, and the transcript line it writes (the app reads both)
echo_user() {
  local line
  line=$(printf '%s,"session_id":"%s","uuid":"%s"}' "${1%\}}" "$sid" "$(cat /proc/sys/kernel/random/uuid)")
  mkdir -p ~/.claude/projects/-fake && printf '%s\n' "$line" >> ~/.claude/projects/-fake/"$sid".jsonl
  [ -n "$replay" ] || return 0
  printf '%s\n' "$line"
}

stopped() {
  emit "{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"$1\",\"response\":{\"still_queued\":[]}}}"
  emit '{"type":"result","subtype":"error_during_execution","is_error":true,"session_id":"__SID__"}'
}

refused() {
  emit '{"type":"stream_event","event":{"type":"message_start","message":{"id":"msg_fake_deny","type":"message","role":"assistant","content":[]}},"session_id":"__SID__"}'
  emit '{"type":"assistant","message":{"id":"msg_fake_deny","type":"message","role":"assistant","content":[{"type":"text","text":"OK, I won'"'"'t do that. What would you like instead?"}]},"session_id":"__SID__"}'
  emit '{"type":"result","subtype":"success","is_error":false,"session_id":"__SID__"}'
}

# A permission mode change: answered as Claude does, with the new mode in a status event
mode() {
  local m=${1#*\"mode\":\"}; m=${m%%\"*}
  emit "{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"$(request_id "$1")\",\"response\":{\"mode\":\"$m\"}}}"
  emit "{\"type\":\"system\",\"subtype\":\"status\",\"status\":null,\"permissionMode\":\"$m\",\"session_id\":\"__SID__\"}"
}

request_id() { local r=${1#*\"request_id\":\"}; printf '%s' "${r%%\"*}"; }

# Context use, as Claude's get_context_usage reports it: grows each turn, back down after a
# compaction. Starts high, so the meter shows.
ctx=600000
usage() {
  emit "{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"$(request_id "$1")\",\"response\":{\"totalTokens\":$ctx,\"maxTokens\":1000000,\"autoCompactThreshold\":967000,\"isAutoCompactEnabled\":true,\"percentage\":$(( ctx / 10000 ))}}}"
}

# A compaction, as Claude streams one: compacting for a while, the boundary, done
compact() {
  emit '{"type":"system","subtype":"status","status":"compacting","session_id":"__SID__"}'
  sleep 3
  emit "{\"type\":\"system\",\"subtype\":\"compact_boundary\",\"compact_metadata\":{\"trigger\":\"auto\",\"pre_tokens\":$ctx,\"post_tokens\":13000},\"session_id\":\"__SID__\",\"uuid\":\"$(cat /proc/sys/kernel/random/uuid)\"}"
  emit '{"type":"system","subtype":"status","status":null,"compact_result":"success","session_id":"__SID__"}'
  ctx=13000
}

# Messages sent during a turn: Claude holds them until the turn ends (or is interrupted),
# then echoes and answers each
held=()

# One recorded turn. Returns when it ends, however it ends.
play() {
  local want=$1 turn delay kind line msg id
  while IFS=$'\t' read -r -u 3 turn delay kind line; do
    [ "$turn" = "$want" ] || continue
    if read -r -t "$delay" msg; then
      case "$msg" in
        *'"subtype":"interrupt"'*) stopped "$(request_id "$msg")"; return ;;
        *'"subtype":"set_permission_mode"'*) mode "$msg" ;;
        *'"subtype":"get_context_usage"'*) usage "$msg" ;;
        *'"subtype":"background_tasks"'*) emit "{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"$(request_id "$msg")\",\"response\":{}}}" ;;
        *'"type":"user"'*) held+=("$msg") ;;
      esac
    fi
    emit "$line"
    if [ "$kind" = ask ]; then
      id=$(request_id "$line")
      while read -r msg; do
        case "$msg" in
          *'"subtype":"interrupt"'*) stopped "$(request_id "$msg")"; return ;;
          *'"subtype":"get_context_usage"'*) usage "$msg" ;;
          *'"type":"user"'*) held+=("$msg") ;;
          *"\"request_id\":\"$id\""*'"behavior":"deny"'*) refused; return ;;
          *"\"request_id\":\"$id\""*) break ;;
        esac
      done
    fi
  done 3< "$rec"
}

while read -r msg; do
  case "$msg" in
    *'"subtype":"set_permission_mode"'*) mode "$msg" ;;
    *'"subtype":"get_context_usage"'*) usage "$msg" ;;
    *'"content":"compact"'*)
      # An auto-compaction during a turn, then a short reply
      echo_user "$msg"
      emit '{"type":"system","subtype":"status","status":"requesting","session_id":"__SID__"}'
      compact
      emit '{"type":"assistant","message":{"id":"msg_fake_compact","type":"message","role":"assistant","content":[{"type":"text","text":"Carrying on from the summary."}]},"session_id":"__SID__"}'
      emit '{"type":"result","subtype":"success","is_error":false,"session_id":"__SID__"}' ;;
    *'"content":"grow"'*)
      # A turn that fills the context a lot (a big file read)
      echo_user "$msg"
      ctx=$(( ctx + 150000 ))
      emit '{"type":"assistant","message":{"id":"msg_fake_grow","type":"message","role":"assistant","content":[{"type":"text","text":"Read a big file."}]},"session_id":"__SID__"}'
      emit '{"type":"result","subtype":"success","is_error":false,"session_id":"__SID__"}' ;;
    *'"content":"idle"'*)
      # A short turn, then Claude compacting while nothing runs
      echo_user "$msg"
      emit '{"type":"assistant","message":{"id":"msg_fake_idle","type":"message","role":"assistant","content":[{"type":"text","text":"Done. (Idle compaction comes next.)"}]},"session_id":"__SID__"}'
      emit '{"type":"result","subtype":"success","is_error":false,"session_id":"__SID__"}'
      sleep 2
      compact ;;
    *'"content":"big"'*)
      # A tool result as long as a big file read: rtach's replay after a reattach (its last
      # 16KB) is then a fragment of it, as with real conversations
      echo_user "$msg"
      big=$(head -c 150000 /dev/zero | tr '\0' 'x')
      emit "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_big\",\"content\":\"$big\"}]},\"session_id\":\"__SID__\"}"
      emit '{"type":"result","subtype":"success","is_error":false,"session_id":"__SID__"}' ;;
    *'"type":"user"'*)
      held=("$msg")
      while [ ${#held[@]} -gt 0 ]; do
        msg=${held[0]}; held=("${held[@]:1}")
        echo_user "$msg"
        play $(( played % turns ))
        played=$(( played + 1 ))
        ctx=$(( ctx + 110000 ))
      done ;;
  esac
done
